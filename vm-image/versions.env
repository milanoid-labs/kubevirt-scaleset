# Pinned inputs of the runner VM image. Single source of truth for build.sh.
# Keep RUNNER_VERSION / GH_VERSION in step with homelab-cluster's runner/Dockerfile, so a
# workflow behaves the same on homelab-runners (pods) and homelab-runners-vm (VMs).

# Ubuntu 24.04 cloud image: a dated build, never "current", so a rebuild is reproducible.
# Checksum from https://cloud-images.ubuntu.com/noble/<date>/SHA256SUMS
UBUNTU_RELEASE=20260926
UBUNTU_SHA256=6a81c37564db9b1ee84e141922625e1d7c5b389b99bb3c572e0243607d5bb4d2

# github.com/actions/runner release asset actions-runner-linux-x64-<version>.tar.gz
RUNNER_VERSION=2.338.1
RUNNER_SHA256=08e9ccb3604d2462c24b5e33604dc30810296ca15cc65f23cffd4317eb144c37

# github.com/cli/cli release asset gh_<version>_linux_amd64.deb
GH_VERSION=2.103.0
GH_SHA256=4a48fa23b9ce9581f3304b822f3e014812f26519b134f89b37db8bc7d74746e1

# Virtual disk size. The qcow2 file only holds used blocks; inside the VM, cloud-init
# grows the root filesystem to this size. Jobs write into KubeVirt's per-VM overlay on
# kubevirt01's disk, which is gone when the VM is.
DISK_SIZE=20G
